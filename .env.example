# Copia este archivo a .env.local y rellena la clave. Nunca subas claves reales.

# Clave del proveedor de lenguaje (Google AI Studio). Sin clave, la app funciona en modo reducido.
GOOGLE_GENERATIVE_AI_API_KEY=

# Proveedor del modelo. Solo se admite google; otro valor degrada a modo reducido.
LLM_PROVIDER=google

# Identificador del modelo de Google.
LLM_MODEL=gemini-flash-latest

# Origen público del sitio (canonical y sitemap). Se lee al compilar; en Docker va como ARG de la etapa de build.
URL_SITIO=http://localhost:3000
