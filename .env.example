# Copia este archivo a .env.local y rellena la clave. Nunca subas claves reales.

# Clave del proveedor de lenguaje (Google AI Studio). Sin clave, el tutor funciona en modo reducido.
GOOGLE_GENERATIVE_AI_API_KEY=tu_clave_aqui

# Proveedor: google (por defecto), openai o anthropic.
LLM_PROVIDER=google

# Identificador del modelo. Valor provisional; se fija definitivamente al integrar el tutor.
LLM_MODEL=gemini-flash-latest
